# Copy to .env, then export with: set -a; . ./.env; set +a
# Existing local databases remain in backend/flowcast.sqlite3 when this is unset.
FLOWCAST_DB_PATH=./data/flowcast.sqlite3
# Comma-separated development origins; production requests use the same origin.
FLOWCAST_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Used by the Docker start command or a shell command that references it.
PORT=8000
